{
  "name": "chatforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ChatForge - White-Label AI Chat Widget Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "start:frontend": "npm run start --workspace=frontend",
    "start:backend": "npm run start:prod --workspace=backend",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "fix:auth": "node scripts/fix-auth-rls.js",
    "fix:recursive-rls": "node scripts/fix-recursive-rls.js",
    "fix:user-role": "node scripts/apply-default-user-role.js",
    "fix:profile": "node scripts/fix-profile-loading.js",
    "verify:auth": "node scripts/verify-auth-fix.js",
    "check:rls": "node scripts/check-rls-policies.js",
    "diagnose:profile": "node scripts/diagnose-profile-issue.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "concurrently": "^9.2.1",
    "puppeteer": "^24.35.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
